# Port d'écoute (HolidayHub = 7700 ; 3000/3001/3002/7000/7500/7600 sont déjà pris)
PORT=7700

# 127.0.0.1 en production : seul Apache doit joindre l'app
HOST=127.0.0.1

# Adresse publique — sert au sitemap, aux balises Open Graph et aux liens de partage
BASE_URL=https://holidayhub.teoasseline.fr

# Emplacement de la base SQLite (ignorée par git)
DB_PATH=data/holidayhub.db

# Un planning sans aucune visite depuis ce nombre de jours est supprimé
RETENTION_DAYS=365

# Anti-abus : créations de planning autorisées par IP et par heure
CREATE_PER_HOUR=20
